# Copy to .env for local development. Never store real credentials in Git.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-hex-secret

# For Railway, set DB_* with references to the Railway MySQL service variables.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotel_management
DB_USERNAME=root
DB_PASSWORD=
DB_USE_SSL=false

# Railway supplies PORT automatically; use SERVER_PORT for local runs.
SERVER_PORT=9090
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_DDL_AUTO=update

# Comma-separated exact browser origins. Replace with the Vercel production domain.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ASSISTANT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment integration. Populate only in the deployment secret store.
BANK_ID=MB
BANK_ACCOUNT_NO=replace-with-bank-account-number
BANK_ACCOUNT_NAME=AZURE BAY
SEPAY_API_KEY=replace-with-sepay-webhook-secret

# Assistant is optional and remains disabled unless its service is deployed.
AI_ASSISTANT_ENABLED=false
AI_BUSINESS_TOOLS_ENABLED=false
AI_BOOKING_TOOLS_ENABLED=false
AI_CORPUS_MODE=production
AI_SERVICE_URL=http://127.0.0.1:8006
AI_SERVICE_AUTH_TOKEN=
