# Copy to .env locally. No credentials are supplied in this example.
# Set a private, randomly generated service token shared only with Spring.
# AI_SERVICE_AUTH_TOKEN=replace-with-a-private-service-token
AI_CORPUS_MODE=production
# GEMINI_API_KEY=configure-privately
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=MINIMAL  # Optional: MINIMAL | LOW | MEDIUM | HIGH
# GEMINI_TRANSIENT_RETRIES=0  # Optional bounded retry (0..2) for transient HTTP 503/429 within TurnBudget
# GEMINI_RETRY_BACKOFF_MS=400  # Base exponential backoff in ms (0..5000) when retries > 0
# AI_INDEX_PATH=.local/assistant-index/production/<snapshotId>
# Offline Phase 1 indexing only; these do not change FAQ generation or AI_INDEX_PATH.
# Model/dimension/tasks/defaults are centralized in app/indexing.py.
# AI_EMBEDDING='{"model":"gemini-embedding-001","dimension":768,"revision":"001"}'
# AI_CHUNKING='{"max_characters":2000}'
# AI_QDRANT_URL=http://127.0.0.1:6333
# AI_QDRANT_API_KEY=configure-privately-if-required
# AI_INDEX_HTTP_TIMEOUT=30
# Rebuild requires --allow-embedding-api. No fake/readiness flags.
# Phase 3: default hybrid requires an active paired snapshot, Qdrant and pinned review artifacts.
# AI_RETRIEVAL_MODE=hybrid
# AI_DEMO_SOURCE_PACK=d1_fixture  # demo_synthetic only: d1_fixture | academic_policies
# AI_DEPENDENCY_LATCH_COOLDOWN_S=0  # 0 keeps permanent not-ready latch until restart
# AI_HYBRID='{"bm25_top_k":10,"vector_top_k":10,"final_top_k":3,"rrf_constant":60}'
# Explicit AI_RETRIEVAL_MODE=bm25 uses AI_INDEX_PATH; verification remains mandatory.
# Paths must be under .local/grounding/<mode>/. Placeholders below are NOT usable publications.
# AI_GROUNDING='{"catalog_path":".local/grounding/production/<release>/catalog.json","catalog_sha256":"<64-lowercase-hex>","sources_path":".local/grounding/production/<release>/sources.json","sources_sha256":"<64-lowercase-hex>","authorities":["<approved-authority>"],"context_input_tokens":6000,"max_evidence":3}'
# See docs/GROUNDING.md for independent review/publication and offline validation.
