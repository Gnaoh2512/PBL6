{
  "schema_version": "academic-demo-configuration-1",
  "working_directory": "ai-service",
  "entrypoint": ["python", "-m", "uvicorn", "app.main:create_app", "--factory", "--host", "127.0.0.1", "--port", "8006"],
  "snapshot_family": "paired_bm25_vector",
