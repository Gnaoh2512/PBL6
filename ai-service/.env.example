# Application
APP_NAME=ai-service
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8006
LOG_LEVEL=INFO

# Existing Spring Boot backend
BACKEND_API_URL=http://localhost:9090
BACKEND_REQUEST_TIMEOUT_SECONDS=5

# Required for the recommendations route. Set to a long random value in local .env.
AI_SERVICE_AUTH_TOKEN=

# Leave empty until the backend implements a service-to-service credential contract.
BACKEND_INTERNAL_API_KEY=
