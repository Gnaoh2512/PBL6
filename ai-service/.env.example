# Application
APP_NAME=ai-service
APP_ENV=development
LOG_LEVEL=INFO

# Existing Spring Boot backend
BACKEND_API_URL=http://localhost:9090
BACKEND_REQUEST_TIMEOUT_SECONDS=5

# Required for the recommendations route. Set to a long random value in local .env.
AI_SERVICE_AUTH_TOKEN=

# Optional for natural-language recommendations. Structured JSON search works without these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=15
HOTEL_TIMEZONE=Asia/Ho_Chi_Minh
